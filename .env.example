# Shared local development settings. Copy to .env; never commit the copy.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/ai_hr.db

# boss-cli is invoked as a separate process by the backend adapter.
# The default runs the compiled submodule from the project root.
BOSS_CLI_COMMAND=node
BOSS_CLI_ENTRYPOINT=boss-cli/dist/cli/index.js
BOSS_CLI_TIMEOUT_SECONDS=120

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:5173

# Used by the Vite frontend when a direct backend URL is preferred.
VITE_API_BASE_URL=http://localhost:8000
